# Copy to .env and fill in. Vite only exposes variables that start with VITE_.

# Google Maps JavaScript API key with the Places API enabled.
# Powers the "Moving from" and "Moving to" search boxes. Without it they are plain text boxes.
VITE_GOOGLE_PLACES_API_KEY=

# AI survey API (FastAPI on AWS EC2, which sends each video to the Modal GPU).
# Default: the live server. For a local API use http://localhost:8000
# VITE_SURVEY_API_URL=https://instant-booking.moversly.com/ai

# Stripe publishable key. Must match the mode (live or test) of the Stripe secret key the
# Moversly payment-intent API uses. Default: the live key the Malaysia project uses, so a
# real card is really charged. Use a pk_test_ key once the Moversly team enables test mode.
# VITE_STRIPE_PUBLISHABLE_KEY=
